#!/usr/bin/python3 -I
"""SENTINEL tool-protocol adapter for the TypeScript checker.

Reads one sentinel-tool-protocol-v1 request from stdin, runs the locked
sentinel-ts check (fresh coverage CRAP plus the Stryker mutation run) from the
repository named in the sibling ``home`` file and writes exactly one response
to stdout. Checker output goes to a temporary log, never to this stdout.
"""

import json
import subprocess
import signal
import sys
import tempfile
from pathlib import Path


STATUS_BY_EXIT = {
    0: "passed",
    1: "toolError",
    2: "qualityFailed",
    3: "usageConfigError",
    4: "baselineFailed",
    5: "dependencyError",
    6: "backendError",
    7: "evidenceError",
    8: "cancelled",
}
IDENTITY_KEYS = ("protocolVersion", "requestId", "command", "moduleId", "language")


def main() -> int:
    here = Path(__file__).resolve().parent
    manifest = json.loads((here / "sentinel-tool.json").read_text(encoding="utf-8"))
    home = Path((here / "home").read_text(encoding="utf-8").splitlines()[0])
    request = json.load(sys.stdin)
    response = {key: request.get(key) for key in IDENTITY_KEYS}
    response["toolVersion"] = manifest["version"]
    if "selection" in request:
        response["selection"] = request["selection"]

    def finish(exit_code: int, *, no_changes: bool = False) -> int:
        status = "noChanges" if no_changes else STATUS_BY_EXIT.get(exit_code, "backendError")
        exit_code = 6 if status == "backendError" else exit_code
        response.update(status=status, exitCode=exit_code, passed=status == "passed")
        sys.stdout.write(json.dumps(response, separators=(",", ":")) + "\n")
        sys.stdout.flush()
        return exit_code

    if (
        request.get("protocolVersion") != "sentinel-tool-protocol-v1"
        or request.get("command") != "check"
        or request.get("language") != manifest["language"]
    ):
        return finish(3)
    gate = request.get("gate") or {}
    execution_mode = request.get("executionMode", "parallel")
    if execution_mode not in ("parallel", "sequential"):
        return finish(3)
    response["executionMode"] = execution_mode
    # The cross-platform launcher is Python; run it with this interpreter so no PATH lookup is involved.
    command = [
        sys.executable, "-I", "-B", str(home / "scripts" / "toolchain.py"), "node", "--entry", "sentinel-ts", "--",
        "check", "--project", request["projectRoot"],
        "--execution-mode", execution_mode,
    ]
    if request.get("config"):
        # sentinel-ts accepts only project-relative config paths; the protocol sends absolute ones.
        config = Path(request["config"])
        try:
            relative = config.resolve().relative_to(Path(request["projectRoot"]).resolve())
        except ValueError:
            return finish(3)
        command += ["--config", relative.as_posix()]
    if "crapMax" in gate:
        command += ["--crap-max", str(gate["crapMax"])]
    if "mutationMin" in gate:
        command += ["--mutation-min", str(gate["mutationMin"])]
    for changed in request.get("changedFiles") or []:
        command += ["--changed-file", str(changed)]
    for field, option in (("files", "--file"), ("functions", "--function"), ("tests", "--tests")):
        for value in request.get("selection", {}).get(field, []):
            command += [option, value]
    with tempfile.TemporaryDirectory(prefix="sentinel-tool-typescript-") as directory:
        result_file = Path(directory) / "result.json"
        with open(Path(directory) / "checker.log", "wb") as log, open(result_file, "wb") as output:
            try:
                process = subprocess.Popen(
                    command,
                    cwd=request["projectRoot"],
                    stdin=subprocess.DEVNULL,
                    stdout=output,
                    stderr=log,
                )
                try:
                    process.wait()
                except KeyboardInterrupt:
                    process.send_signal(signal.SIGINT)
                    try:
                        process.wait(timeout=25)
                    except subprocess.TimeoutExpired:
                        process.kill()
                        process.wait()
                        return finish(6)
                    return finish(8)
                completed = process
            except OSError:
                return finish(5)
        if completed.returncode not in (0, 2):
            try:
                diagnostic = json.loads((Path(directory) / "checker.log").read_text(encoding="utf-8"))["error"]["code"]
                if isinstance(diagnostic, str):
                    response["diagnostic"] = diagnostic
            except (OSError, ValueError, KeyError, TypeError):
                pass  # The process status still reports the failed invocation.
        if completed.returncode in (0, 2):
            try:
                result = json.loads(result_file.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                return finish(6)
            if not isinstance(result, dict) or result.get("pass") is not (completed.returncode == 0):
                return finish(6)
            if result.get("changedScope") == "empty":
                return finish(0, no_changes=True) if completed.returncode == 0 and "changedFiles" in request else finish(6)
            response["details"] = {key: result[key] for key in ("scope", "crap", "mutation", "mutationDetails") if key in result}
    return finish(completed.returncode)


if __name__ == "__main__":
    sys.exit(main())
